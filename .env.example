# 论文智答 · 论文知识问答平台 — 环境变量模板
# 复制为 .env 后填写真实密钥。不要把 .env 或真实密钥提交到仓库。

# Application
APP_NAME=论文智答
APP_VERSION=0.1.0
DEBUG=true

# Server
HOST=127.0.0.1
PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///data/graphrag.db

# LLM — 阿里云百炼 OpenAI 兼容接口
LLM_PROVIDER=dashscope
LLM_MODEL=qwen-plus
LLM_API_KEY=your-dashscope-api-key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Embedding — 阿里云百炼向量模型
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_API_KEY=your-dashscope-api-key
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Storage
DATA_DIR=data
LOG_DIR=logs

# 通用文档解析与分块
PARSER_CHUNK_SIZE=500
PARSER_CHUNK_OVERLAP=50

# 单篇论文精读分块
PAPER_CHUNK_SIZE=1200
PAPER_CHUNK_OVERLAP=150

# Retrieval
RETRIEVAL_TOP_K=5
RETRIEVAL_VECTOR_WEIGHT=0.7
RETRIEVAL_KEYWORD_WEIGHT=0.3

# Memory
SHORT_MEMORY_SIZE=10

# 文献搜索下载 Agent
RESEARCH_TOP_K=20
RESEARCH_SEARCH_TIMEOUT=15
RESEARCH_DOWNLOAD_DELAY=4
RESEARCH_PROXY=
VPN_PORTAL_URL=https://vpn.swjtu.edu.cn
UNPAYWALL_EMAIL=

# Logging
LOG_LEVEL=DEBUG
